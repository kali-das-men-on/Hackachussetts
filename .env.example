# Copy to .env (repo root) and fill in. Never commit .env.
# With DATABASE_URL empty, the site runs on local files in data/ (no Supabase, no AI worker).

# Supabase > Project Settings > Database > Connection string (transaction pooler, port 6543)
DATABASE_URL=
# Supabase > Project Settings > API Keys > secret key (starts with sb_secret_)
SUPABASE_SECRET_KEY=

# AI worker (backend/worker.py): https://openrouter.ai/keys
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna

# Optional: every staff account uses this PIN (otherwise random PINs go to data/gov_users.json)
# GOV_DEMO_PIN=246810
